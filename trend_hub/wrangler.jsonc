{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "today-video-trend-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "TREND_STATE",
      "id": "735a39436f8b4128ac03581250c646d4"
    }
  ]
}
